# -------------------------------------------------------------
# Supabase Configuration
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------
# Razorpay Configuration (Test mode: rzp_test_... / Live: rzp_live_...)
# -------------------------------------------------------------
# Public Key ID exposed to frontend for initializing Razorpay Checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Private Key Secret used exclusively on server for order creation and verification
RAZORPAY_KEY_SECRET=

# Webhook secret set when configuring webhook in Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=

# -------------------------------------------------------------
# Application Configuration
# -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin email allowed to access /admin portal
ADMIN_EMAIL=
