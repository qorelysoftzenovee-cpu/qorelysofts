# ==============================================================================
# Upstash Redis Sliding-Window Rate Limiter Configuration
# ==============================================================================

# Your Upstash Redis REST credentials (from https://console.upstash.com)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# Default Rate Limiting Settings
# Window in milliseconds (e.g., 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum number of requests allowed within the window
RATE_LIMIT_MAX=100

# Burst tolerance percentage (0.10 = allow up to 10% overage before hard drop)
RATE_LIMIT_BURST_TOLERANCE=0.10

# Redis key prefix
RATE_LIMIT_KEY_PREFIX="ratelimit:api"

# Optional port for the example server
PORT=3000
