{
  "name": "tailwind-landing-kit",
  "version": "1.0.0",
  "description": "Production-ready, copy-pasteable Tailwind CSS + React landing page components with TypeScript for SaaS and developer products.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
