# =============================================================================
# STRIPE & RAZORPAY WEBHOOKS HANDLER ENVIRONMENT CONFIGURATION
# =============================================================================

# Stripe Webhook Signing Secret (starts with whsec_...)
# Obtain from Stripe Dashboard > Developers > Webhooks or via Stripe CLI (`stripe listen`)
STRIPE_WEBHOOK_SECRET="whsec_1234567890abcdefghijklmnopqrstuvwxyz123456"

# Razorpay Webhook Secret
# Configured in Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_super_secure_99"

# Database Connection URL (PostgreSQL / MySQL / SQLite)
# Used by your database adapter (Prisma, Drizzle, Knex, pg)
DATABASE_URL="postgresql://postgres:password@localhost:5432/myapp_db?schema=public"

# Optional: Stripe Secret Key for API operations
STRIPE_SECRET_KEY="sk_test_51Abc..."

# Optional: Razorpay Key ID & Secret
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
